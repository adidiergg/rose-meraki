---
import logo from '../assets/logo.svg';

const links = [
	{ label: 'Estudio', href: '#estudio' },
	{ label: 'Sobre mí', href: '#sobre-mi' },
	{ label: 'Proyectos', href: '#proyectos' },
	{ label: 'Contacto', href: '#contacto' },
];
---

<header class="site-header">
	<a class="logo" href="#top" aria-label="Rose Meraki, inicio">
		<img src={logo.src} alt="" width={logo.width} height={logo.height} />
		<span class="logo__wordmark">Rose Meraki</span>
	</a>

	<button
		class="nav-toggle"
		type="button"
		aria-expanded="false"
		aria-controls="site-nav"
		aria-label="Abrir menú"
	>
		<span class="nav-toggle__bar" aria-hidden="true"></span>
		<span class="nav-toggle__bar" aria-hidden="true"></span>
		<span class="nav-toggle__bar" aria-hidden="true"></span>
	</button>

	<nav id="site-nav" class="site-nav" aria-label="Principal">
		<ul>
			{
				links.map((link) => (
					<li>
						<a href={link.href}>{link.label}</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>

<style>
	.site-header {
		position: fixed;
		inset-block-start: 0;
		inset-inline: 0;
		z-index: 1000;
		box-sizing: border-box;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: clamp(0.85rem, 2.5vw, 1.25rem) var(--section-gutter);
		background: transparent;
		border-bottom: 1px solid transparent;
		transition:
			background-color 0.3s ease,
			border-bottom-color 0.3s ease,
			transform 0.35s cubic-bezier(0.22, 0.61, 0.36, 1),
			-webkit-backdrop-filter 0.3s ease,
			backdrop-filter 0.3s ease;
	}

	.site-header.is-scrolled,
	.site-header.is-open {
		background: color-mix(in srgb, var(--color-primary) 55%, transparent);
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
		border-bottom-color: rgb(253 244 234 / 0.14);
	}

	/* Ocultar el header al hacer scroll hacia abajo. */
	.site-header.is-hidden {
		transform: translateY(-100%);
		pointer-events: none;
	}

	.logo {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		line-height: 1;
		text-decoration: none;
	}

	.logo img {
		width: auto;
		height: clamp(1.75rem, 2.5vw, 2.4rem);
	}

	.logo__wordmark {
		display: none;
		font-family: var(--font-display);
		font-size: 1.45rem;
		line-height: 1;
		letter-spacing: -0.01em;
		color: var(--color-white);
		white-space: nowrap;
	}

	.nav-toggle {
		display: none;
		position: relative;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		border: 0;
		border-radius: 0.5rem;
		background: transparent;
		color: var(--color-cream);
		cursor: pointer;
	}

	.nav-toggle__bar {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 1.5rem;
		height: 2px;
		margin-left: -0.75rem;
		margin-top: -1px;
		border-radius: 2px;
		background: currentColor;
		transition:
			transform 0.3s ease,
			opacity 0.3s ease;
	}

	.nav-toggle__bar:nth-child(1) {
		transform: translateY(-7px);
	}

	.nav-toggle__bar:nth-child(2) {
		transform: translateY(0);
	}

	.nav-toggle__bar:nth-child(3) {
		transform: translateY(7px);
	}

	.site-header.is-open .nav-toggle__bar:nth-child(1) {
		transform: rotate(45deg);
	}

	.site-header.is-open .nav-toggle__bar:nth-child(2) {
		opacity: 0;
	}

	.site-header.is-open .nav-toggle__bar:nth-child(3) {
		transform: rotate(-45deg);
	}

	.site-nav ul {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: clamp(1.5rem, 6vw, 4rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.site-nav a {
		font-family: var(--font-text);
		font-size: clamp(0.95rem, 1.6vw, 1.2rem);
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: rgb(253 244 234 / 0.82);
		text-decoration: none;
		transition: color 0.3s ease;
	}

	.site-nav a:hover {
		color: var(--color-secondary);
	}

	@media (max-width: 768px) {
		.logo__wordmark {
			display: inline;
		}

		.nav-toggle {
			display: inline-flex;
		}

		.site-nav {
			position: absolute;
			inset-inline: 0;
			top: 100%;
			max-height: 0;
			overflow: hidden;
			visibility: hidden;
			opacity: 0;
			transform: translateY(-0.5rem);
			background: color-mix(in srgb, var(--color-primary) 92%, transparent);
			-webkit-backdrop-filter: blur(16px);
			backdrop-filter: blur(16px);
			border-bottom: 1px solid rgb(253 244 234 / 0.14);
			transition:
				max-height 0.35s cubic-bezier(0.22, 0.61, 0.36, 1),
				opacity 0.3s ease,
				transform 0.35s cubic-bezier(0.22, 0.61, 0.36, 1),
				visibility 0s linear 0.35s;
		}

		.site-header.is-open .site-nav {
			max-height: 24rem;
			visibility: visible;
			opacity: 1;
			transform: none;
			transition:
				max-height 0.35s cubic-bezier(0.22, 0.61, 0.36, 1),
				opacity 0.3s ease,
				transform 0.35s cubic-bezier(0.22, 0.61, 0.36, 1),
				visibility 0s linear 0s;
		}

		.site-nav ul {
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			padding: 0.5rem var(--section-gutter) 1.25rem;
		}

		.site-nav li {
			border-bottom: 1px solid rgb(253 244 234 / 0.1);
		}

		.site-nav li:last-child {
			border-bottom: 0;
		}

		.site-nav a {
			display: block;
			padding: 1rem 0;
			font-size: 1.05rem;
			letter-spacing: 0.16em;
		}
	}

	@media (max-width: 600px) {
		.logo img {
			height: 1.75rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header,
		.site-nav,
		.nav-toggle__bar,
		.site-nav a {
			transition: none;
		}
	}
</style>

<script>
	const header = document.querySelector<HTMLElement>('.site-header');
	const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
	const nav = document.querySelector<HTMLElement>('.site-nav');
	const desktopQuery = window.matchMedia('(min-width: 769px)');

	let lastScrollY = window.scrollY;

	const focusWithoutScroll = (element: HTMLElement | null | undefined) => {
		element?.focus({ preventScroll: true });
	};

	// En móvil el menú cerrado sigue visible durante el fade.
	// `inert` lo saca del tabulador al momento. En escritorio, no.
	const setNavInert = (inert: boolean) => {
		if (!nav) return;
		if (inert && !desktopQuery.matches) nav.setAttribute('inert', '');
		else nav.removeAttribute('inert');
	};

	// offsetTop ignora el translate del reveal, así la sección queda
	// bajo el header fijo cuando esa animación termina.
	const scrollToSection = (target: HTMLElement) => {
		const offset = header?.getBoundingClientRect().height ?? 0;
		window.scrollTo({ top: Math.max(0, target.offsetTop - offset) });
	};

	// El header se sale de pantalla en escritorio. `inert` lo saca del tabulador.
	const setHeaderHidden = (hidden: boolean) => {
		if (!header) return;
		if (header.classList.contains('is-hidden') === hidden) return;

		header.classList.toggle('is-hidden', hidden);

		if (hidden) {
			const active = document.activeElement;
			if (active instanceof HTMLElement && header.contains(active)) {
				active.blur();
			}
			header.setAttribute('inert', '');
		} else {
			header.removeAttribute('inert');
		}
	};

	const setMenu = (open: boolean, restoreFocus = false) => {
		const wasOpen = header?.classList.contains('is-open') ?? false;
		header?.classList.toggle('is-open', open);
		toggle?.setAttribute('aria-expanded', String(open));
		toggle?.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');

		// El header nunca se oculta mientras el menú está abierto.
		if (open) {
			header?.classList.remove('is-hidden');
			header?.removeAttribute('inert');
			setNavInert(false);
			const firstLink = nav?.querySelector<HTMLAnchorElement>('a');
			focusWithoutScroll(firstLink);
			return;
		}

		setNavInert(true);
		if (restoreFocus && wasOpen) {
			focusWithoutScroll(toggle);
		}
	};

	const onScroll = () => {
		const y = window.scrollY;
		const scrollingDown = y > lastScrollY;
		const pastThreshold = y > 120;
		const menuOpen = header?.classList.contains('is-open') ?? false;

		header?.classList.toggle('is-scrolled', y > 10);

		// En móvil el header no se oculta al hacer scroll hacia abajo.
		const shouldHide = desktopQuery.matches && !menuOpen && pastThreshold && scrollingDown;
		setHeaderHidden(shouldHide);

		lastScrollY = y;
	};

	toggle?.addEventListener('click', () => {
		const isOpen = header?.classList.contains('is-open') ?? false;
		setMenu(!isOpen, isOpen);
	});

	// Cerrar el menú al pulsar un enlace y llevar el foco al destino.
	// preventDefault evita que el salto de ancla devuelva el foco al documento.
	nav?.addEventListener('click', (event) => {
		const link = (event.target as Element | null)?.closest('a');
		if (!(link instanceof HTMLAnchorElement)) return;

		const href = link.getAttribute('href');
		const target = href?.startsWith('#') ? document.querySelector(href) : null;

		if (target instanceof HTMLElement) {
			event.preventDefault();
		}

		setMenu(false, false);

		if (!(target instanceof HTMLElement)) return;

		const heading = target.querySelector('h1, h2, h3');
		const focusTarget = heading instanceof HTMLElement ? heading : target;
		if (!focusTarget.hasAttribute('tabindex')) {
			focusTarget.setAttribute('tabindex', '-1');
		}

		scrollToSection(target);
		focusWithoutScroll(focusTarget);
		if (href) history.pushState(null, '', href);
	});

	header?.querySelector<HTMLAnchorElement>('.logo')?.addEventListener('click', () => {
		if (header.classList.contains('is-open')) {
			setMenu(false, false);
		}
	});

	// Si el foco sale del header, el menú móvil se cierra.
	header?.addEventListener('focusout', () => {
		if (!header.classList.contains('is-open')) return;

		requestAnimationFrame(() => {
			if (!header.classList.contains('is-open')) return;
			const active = document.activeElement;
			if (active instanceof Node && header.contains(active)) return;
			setMenu(false, false);
		});
	});

	// Cerrar el menú con Escape y devolver el foco al botón.
	document.addEventListener('keydown', (event) => {
		if (event.key !== 'Escape') return;
		if (!header?.classList.contains('is-open')) return;
		setMenu(false, true);
	});

	// Cerrar el menú al volver a escritorio, y re-mostrar el header al pasar a móvil.
	desktopQuery.addEventListener('change', (event) => {
		if (event.matches) {
			setMenu(false, false);
		} else {
			setHeaderHidden(false);
			setNavInert(true);
		}
	});

	// Un enlace directo (#contacto, etc.) no debe quedar bajo el header fijo.
	const alignHash = () => {
		const hash = location.hash;
		if (!hash || hash === '#top' || hash === '#contenido') return;
		const target = document.querySelector(hash);
		if (!(target instanceof HTMLElement)) return;
		const offset = header?.getBoundingClientRect().height ?? 0;
		lastScrollY = Math.max(0, target.offsetTop - offset);
		scrollToSection(target);
	};

	window.addEventListener('scroll', onScroll, { passive: true });
	window.addEventListener('load', () => {
		// The browser scrolls to the fragment on load; correct it after that.
		setTimeout(alignHash, 0);
	});
	onScroll();
	setNavInert(true);
	alignHash();
</script>
