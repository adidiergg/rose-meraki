---
import DotPattern from './DotPattern.astro';

const year = new Date().getFullYear();
---

<section class="contact has-glow" id="contacto" aria-labelledby="contacto-title" data-section-reveal>
	<div class="dot-cluster dot-cluster--edge" aria-hidden="true">
		<DotPattern columns={3} rows={4} opacity={0.5} />
	</div>
	<div class="dot-cluster dot-cluster--corner" aria-hidden="true">
		<DotPattern columns={5} rows={3} opacity={0.46} />
	</div>
	<div class="inner">
		<p class="eyebrow">Contacto</p>

		<h2 id="contacto-title">Hablemos de tu<br />próxima sesión.</h2>

		<p class="lead">
			Cuéntame qué tienes en mente. Respondo en menos de 48 horas con disponibilidad y una
			propuesta de luz.
		</p>

		<div class="links">
			<a class="mail" href="mailto:hola@rosemeraki.com">
				hola@rosemeraki.com
				<span aria-hidden="true">↗</span>
			</a>
			<a
				class="social"
				href="https://instagram.com/rosemeraki"
				target="_blank"
				rel="noopener noreferrer"
			>
				@rosemeraki
				<span class="social__external" aria-hidden="true">↗</span>
				<span class="visually-hidden"> (se abre en una pestaña nueva)</span>
			</a>
		</div>

		<footer class="foot">
			<span>© {year} Rose Meraki</span>
			<span>Estudio y exterior</span>
		</footer>
	</div>
</section>

<style>
	.contact {
		--glow-color: color-mix(in srgb, var(--color-secondary) 22%, transparent);
		--glow-size: 42rem;
		box-sizing: border-box;
		padding: var(--section-block) var(--section-gutter);
		background: var(--color-ink);
		color: var(--color-cream);
	}

	.inner {
		position: relative;
		z-index: 1;
		max-width: var(--content-width);
		margin: 0 auto;
	}

	/* Dark close: light dots in the padding, clear of the headline and the footer line. */
	.dot-cluster--edge {
		top: 1.15rem;
		right: var(--section-gutter);
		width: 1.25rem;
	}

	.dot-cluster--corner {
		bottom: 1.15rem;
		left: var(--section-gutter);
		width: 2.1rem;
	}

	.eyebrow {
		margin: 0 0 clamp(2rem, 4vw, 3.5rem);
		font-family: var(--font-text);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--color-secondary);
	}

	h2 {
		margin: 0;
		max-width: 16ch;
		font-family: var(--font-display);
		font-weight: 400;
		font-size: clamp(2.75rem, 8vw, 6.5rem);
		line-height: 0.9;
		letter-spacing: -0.02em;
	}

	.lead {
		margin: clamp(1.5rem, 3vw, 2.5rem) 0 0;
		max-width: 44ch;
		font-size: clamp(1rem, 1.4vw, 1.15rem);
		line-height: 1.55;
		color: var(--color-secondary);
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: clamp(1.25rem, 4vw, 3.5rem);
		margin-top: clamp(2.5rem, 5vw, 4rem);
	}

	.mail {
		display: inline-flex;
		align-items: baseline;
		gap: 0.5rem;
		font-family: var(--font-display);
		font-size: clamp(1.5rem, 3.2vw, 2.75rem);
		line-height: 1;
		color: var(--color-cream);
		text-decoration: none;
		background-image: linear-gradient(currentColor, currentColor);
		background-repeat: no-repeat;
		background-position: 0 100%;
		background-size: 100% 1px;
		padding-bottom: 0.2em;
		transition:
			color 0.3s ease,
			background-size 0.4s cubic-bezier(0.22, 0.61, 0.36, 1);
	}

	.mail:hover,
	.mail:focus-visible {
		color: var(--color-secondary);
		background-size: 0 1px;
	}

	.mail span {
		font-family: var(--font-text);
		font-size: 0.55em;
		transform: translateY(-0.2em);
	}

	.social {
		position: relative;
		display: inline-flex;
		align-items: baseline;
		gap: 0.4rem;
		padding-block: 0.35rem;
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--color-secondary);
		transition: color 0.3s ease;
	}

	.social__external {
		letter-spacing: 0;
		font-size: 0.9em;
	}

	.social:hover,
	.social:focus-visible {
		color: var(--color-cream);
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		clip-path: inset(50%);
		white-space: nowrap;
		border: 0;
	}

	.foot {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 1rem;
		margin-top: clamp(4rem, 9vw, 8rem);
		padding-top: 1.25rem;
		border-top: 1px solid color-mix(in srgb, var(--color-cream) 18%, transparent);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		/* cream al 55% sobre ink (#101010) queda en 5.79:1. */
		color: color-mix(in srgb, var(--color-cream) 55%, transparent);
	}

	@media (max-width: 600px) {
		.dot-cluster--edge {
			display: none;
		}

		.dot-cluster--corner {
			bottom: 0.7rem;
			width: 1.7rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.mail,
		.social {
			transition: none;
		}
	}
</style>
