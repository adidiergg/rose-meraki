---
import DrawPortrait from './DrawPortrait.astro';
import studioColor from '../assets/brand/studio/studio-color.svg';
import studioLineRaw from '../assets/brand/studio/studio-line.svg?raw';

const stats = [
	{ label: 'Sesiones realizadas', value: '120+' },
	{ label: 'Años de archivo', value: '08' },
	{ label: 'Estudio propio', value: '01' },
];
---

<section class="studio has-glow" id="estudio" aria-labelledby="estudio-title" data-section-reveal>
	<div class="art">
		<DrawPortrait
			lineSvg={studioLineRaw}
			colorSrc={studioColor.src}
			colorWidth={studioColor.width}
			colorHeight={studioColor.height}
			label="Retrato ilustrado de Rose Meraki"
			fit="cover"
			focus="center"
			loading="lazy"
			strokeWidth={2.4}
		/>
	</div>

	<div class="inner">
		<p class="eyebrow">El estudio</p>

		<div class="intro">
			<h2 id="estudio-title">Poner el alma<br />en cada sesión</h2>
			<div class="copy">
				<p>
					Rose Meraki nace de una idea simple: una sesión no se posa, se habita. Trabajamos
					despacio, con luz natural y decisiones honestas, hasta que el retrato se parece a quien
					lo protagoniza.
				</p>
				<p>
					Tres principios: escuchar, esperar el gesto y no corregir lo que ya es verdad.
				</p>
			</div>
		</div>

		<dl class="stats">
			{
				stats.map((stat) => (
					<div class="stat">
						<dt>{stat.label}</dt>
						<dd>{stat.value}</dd>
					</div>
				))
			}
		</dl>
	</div>
</section>

<style>
	.studio {
		--glow-color: rgb(188 157 216 / 0.2);
		--glow-size: 40rem;
		--glow-top: 12%;
		--glow-bottom: auto;
		--glow-right: -12%;
		--glow-left: auto;
		box-sizing: border-box;
		padding: 0;
		background: var(--color-primary-light);
		color: var(--color-cream);
	}

	/* The portrait sits behind the copy as a large, bleeding backdrop. */
	.art {
		position: relative;
		display: grid;
		grid-template-rows: minmax(0, 1fr);
		height: 55svh;
		min-height: 22rem;
		-webkit-mask-image: linear-gradient(to bottom, #000 70%, transparent 100%);
		mask-image: linear-gradient(to bottom, #000 70%, transparent 100%);
	}

	/* Softens the top and bottom edges so the portrait reads as the section's
	   own background instead of a pasted rectangle. */
	.art::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(
			to bottom,
			var(--color-primary-light) 0%,
			transparent 10%,
			transparent 88%,
			var(--color-primary-light) 100%
		);
		pointer-events: none;
	}

	.inner {
		position: relative;
		box-sizing: border-box;
		max-width: var(--content-width);
		margin: 0 auto;
		padding: var(--section-block) var(--section-gutter);
	}

	.eyebrow {
		margin: 0 0 clamp(2rem, 4vw, 3.5rem);
		font-family: var(--font-text);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: rgb(253 244 234 / 0.8);
	}

	.intro {
		display: grid;
		gap: clamp(1.5rem, 4vw, 4rem);
		padding-bottom: clamp(3rem, 6vw, 5rem);
	}

	h2 {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 400;
		font-size: clamp(2.6rem, 7vw, 5.5rem);
		line-height: 0.92;
		letter-spacing: -0.02em;
	}

	.copy {
		display: grid;
		gap: 1rem;
		max-width: 48ch;
		font-size: clamp(1rem, 1.4vw, 1.15rem);
		line-height: 1.55;
	}

	.copy p {
		margin: 0;
	}

	.copy p:first-child {
		color: var(--color-cream);
	}

	.copy p:last-child {
		color: rgb(253 244 234 / 0.74);
	}

	.stats {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(1rem, 3vw, 3rem);
		margin: 0;
		padding-top: clamp(2rem, 4vw, 3rem);
		border-top: 1px solid rgb(253 244 234 / 0.25);
	}

	.stat {
		display: flex;
		flex-direction: column-reverse;
		gap: 0.5rem;
	}

	.stat dt {
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: rgb(253 244 234 / 0.8);
	}

	.stat dd {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2.25rem, 5vw, 4.5rem);
		line-height: 0.9;
		letter-spacing: -0.02em;
	}

	@media (min-width: 900px) {
		.studio {
			display: grid;
			grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr);
			align-items: stretch;
			min-height: max(44rem, 90vh);
			padding-block: var(--section-block);
		}

		.art {
			position: absolute;
			inset-block: 0;
			inset-inline-start: 0;
			width: 56%;
			height: auto;
			min-height: 0;
			-webkit-mask-image: linear-gradient(to right, #000 68%, transparent 100%);
			mask-image: linear-gradient(to right, #000 68%, transparent 100%);
		}

		.inner {
			grid-column: 2;
			align-self: center;
			width: 100%;
			max-width: 46rem;
			margin: 0;
			padding-block: 0;
		}

		.intro {
			gap: clamp(1.5rem, 2.5vw, 2.5rem);
		}
	}

	@media (min-width: 900px) and (max-width: 1100px) {
		.studio {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		}

		.art {
			width: 50%;
		}

		.stats {
			grid-template-columns: minmax(0, 1fr);
			gap: 1.25rem;
		}

		.stat {
			flex-direction: row-reverse;
			align-items: baseline;
			justify-content: space-between;
		}
	}

	@media (max-width: 899px) {
		.inner {
			padding-top: var(--section-gutter);
		}
	}

	@media (max-width: 600px) {
		.stats {
			grid-template-columns: minmax(0, 1fr);
			gap: 1.25rem;
		}

		.stat {
			flex-direction: row-reverse;
			align-items: baseline;
			justify-content: space-between;
		}
	}
</style>
