---
import { Font } from 'astro:assets';
import '../styles/tokens.css';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
		<!-- Matches --color-primary in src/styles/tokens.css -->
		<meta name="theme-color" content="#3f1667" />
		<meta name="generator" content={Astro.generator} />
		<script is:inline>
			document.documentElement.classList.add('has-js');
		</script>
		<Font cssVariable="--font-instrument-serif" preload />
		<Font cssVariable="--font-body" />
		<title>Rose Meraki</title>
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}

	body {
		background: var(--color-primary);
		color: var(--color-cream);
		font-family: var(--font-text);
		-webkit-font-smoothing: antialiased;
	}

	.skip-link {
		position: fixed;
		top: 0.75rem;
		left: var(--section-gutter);
		z-index: 2000;
		padding: 0.85rem 1.15rem;
		background: var(--color-cream);
		color: var(--color-primary);
		font-family: var(--font-text);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		text-decoration: none;
	}

	.skip-link:focus {
		/* currentColor matches the page, so the ring is cream on the purple field. */
		outline: 2px solid var(--color-cream);
		outline-offset: 4px;
	}

	.skip-link:not(:focus) {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		clip-path: inset(50%);
		white-space: nowrap;
		border: 0;
	}
</style>
