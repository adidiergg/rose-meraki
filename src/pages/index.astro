---
import Layout from '../layouts/Layout.astro';
import Contact from '../components/Contact.astro';
import DotPattern from '../components/DotPattern.astro';
import DrawPortrait from '../components/DrawPortrait.astro';
import Header from '../components/Header.astro';
import Projects from '../components/Projects.astro';
import Rose from '../components/Rose.astro';
import Studio from '../components/Studio.astro';
// hero-color.webp keeps its transparent background, so it sits on the page's
// purple instead of showing as a dark rectangle.
import heroColor from '../assets/artwork/hero/hero-color.webp';
// The line-art is inlined as raw markup so each path can be drawn on load.
import heroLineRaw from '../assets/artwork/hero/hero-line.svg?raw';
---

<Layout>
	<Header />
	<main id="contenido" tabindex="-1">
		<section class="hero has-glow" id="top">
			<div class="dot-cluster dot-cluster--top" aria-hidden="true">
				<DotPattern columns={5} rows={3} color="var(--color-white)" opacity={0.72} />
			</div>
			<div class="dot-cluster dot-cluster--edge" aria-hidden="true">
				<DotPattern columns={3} rows={4} color="var(--color-white)" opacity={0.72} />
			</div>
			<div class="dot-cluster dot-cluster--foot" aria-hidden="true">
				<DotPattern columns={5} rows={3} color="var(--color-white)" opacity={0.62} />
			</div>
			<div class="hero-content">
				<h1><span class="rose">Rose</span> <span class="meraki">Meraki</span></h1>
			</div>
			<div class="hero-media">
				<DrawPortrait
					lineSvg={heroLineRaw}
					colorSrc={heroColor.src}
					colorWidth={heroColor.width}
					colorHeight={heroColor.height}
					label="Retrato de Rose Meraki"
					fit="contain"
					loading="eager"
					priority
				/>
			</div>
		</section>

		<Studio />
		<Rose />
		<Projects />
		<Contact />
	</main>
</Layout>

<style>
	main:focus {
		outline: none;
	}

	.hero {
		--glow-color: rgb(188 157 216 / 0.14);
		--glow-size: 48rem;
		--glow-top: -35%;
		--glow-right: auto;
		--glow-left: -15%;
		box-sizing: border-box;
		height: 100dvh;
		min-height: 100dvh;
		display: grid;
		padding: var(--header-height) 0 0;
		overflow: hidden;
	}

	.hero-content {
		position: relative;
		z-index: 1;
		align-self: center;
		padding: clamp(1.5rem, 5vw, 5rem);
	}

	/* Brand-sheet clusters, kept in the purple field around the portrait. */
	.dot-cluster--top {
		top: calc(var(--header-height) + 1.35rem);
		left: clamp(var(--section-gutter), 22vw, 22rem);
		width: 4.6rem;
	}

	.dot-cluster--edge {
		top: 32%;
		right: clamp(0.85rem, 2vw, 1.75rem);
		width: 2rem;
	}

	.dot-cluster--foot {
		left: var(--section-gutter);
		bottom: clamp(1.25rem, 3.5vh, 2.75rem);
		width: 4.6rem;
	}

	h1 {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 400;
		font-size: clamp(3rem, 9vw, 10rem);
		letter-spacing: -0.02em;
		color: var(--color-secondary);
		line-height: 0.8;
	}

	.rose {
		display: block;
		font-size: 0.5em;
	}

	.meraki {
		display: block;
		font-size: 1.15em;
	}

	.hero-media {
		position: absolute;
		inset-block-start: var(--header-height);
		inset-block-end: 0;
		inset-inline-end: -8vw;
		z-index: -1;
		display: grid;
		grid-template-rows: minmax(0, 1fr);
		width: 75%;
	}

	@media (min-width: 769px) {
		.hero {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			grid-template-rows: minmax(0, 1fr);
			align-items: stretch;
		}
	}

	@media (max-width: 768px) {
		.hero {
			grid-template-columns: 1fr;
			grid-template-rows: minmax(0, 1fr);
		}

		/* Pull the clusters into the purple bands, flush with the screen edges.
		   The right-edge cluster drops to the bottom corner so it misses the portrait. */
		.dot-cluster--top {
			top: calc(var(--header-height) + 0.35rem);
			left: 0.4rem;
			width: 3.35rem;
		}

		.dot-cluster--edge {
			top: auto;
			right: 0.4rem;
			bottom: 0.4rem;
			width: 2rem;
		}

		.dot-cluster--foot {
			left: 0.4rem;
			bottom: 0.4rem;
			width: 3.35rem;
		}

		/* Único h1 de la página: oculto a la vista, disponible para tecnología de asistencia. */
		.hero-content {
			position: absolute;
			width: 1px;
			height: 1px;
			padding: 0;
			margin: -1px;
			overflow: hidden;
			clip: rect(0, 0, 0, 0);
			clip-path: inset(50%);
			white-space: nowrap;
			border: 0;
		}

		.hero-media {
			position: relative;
			inset: auto;
			z-index: auto;
			width: 100%;
			margin-inline: 0;
		}
	}
</style>

<script>
	const reducedMotionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');

	// Adds `className` when a target enters the viewport, once.
	const whenVisible = (
		targets: NodeListOf<Element>,
		options: IntersectionObserverInit,
		className: string,
	) => {
		if (targets.length === 0) return;

		if (reducedMotionPreference.matches) {
			for (const target of targets) {
				target.classList.add(className);
			}
			return;
		}

		const observer = new IntersectionObserver((entries) => {
			for (const entry of entries) {
				if (!entry.isIntersecting) continue;

				entry.target.classList.add(className);
				observer.unobserve(entry.target);
			}
		}, options);

		for (const target of targets) {
			observer.observe(target);
		}
	};

	// Sections fade in on scroll; portraits start their draw-in the same way.
	whenVisible(
		document.querySelectorAll('[data-section-reveal]'),
		{ threshold: 0, rootMargin: '0px 0px -8% 0px' },
		'is-visible',
	);
	whenVisible(document.querySelectorAll('[data-draw]'), { threshold: 0.25 }, 'is-drawn');
</script>
