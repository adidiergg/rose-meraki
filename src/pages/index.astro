---
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Contact from '../components/Contact.astro';
import Projects from '../components/Projects.astro';
import Studio from '../components/Studio.astro';
import poseLines from '../assets/brand/pose1.png';
// posecolor1-alpha.png is posecolor1.png with its flat #2f2537 background
// removed (flood-filled from the outer edges), so it can sit on the page's
// purple instead of showing as a dark rectangle.
import poseColor from '../assets/brand/posecolor1-alpha.png';

// The line-art alpha becomes a CSS mask so it can be tinted with a design token
// instead of shipping the artwork twice.
const lineMask = await getImage({
	src: poseLines,
	width: 1600,
	format: 'webp',
});
---

<Layout>
	<main>
		<section class="hero">
			<div class="hero-content">
				<h1><span class="rose">Rose</span> <span class="meraki">Meraki</span></h1>
			</div>
			<div
				class="hero-media"
				data-reveal
				role="img"
				aria-label="Retrato de Rose Meraki"
				style={{ '--line-mask': `url("${lineMask.src}")` }}
			>
				<div class="hero-media__stage">
					<div class="hero-media__lines" aria-hidden="true">
						<div class="hero-media__lines-art"></div>
					</div>
					<div class="hero-media__color" aria-hidden="true">
						<Image
							class="hero-image"
							src={poseColor}
							alt=""
							widths={[480, 768, 1200, 1600]}
							sizes="(max-width: 768px) 100vw, 50vw"
							format="webp"
							loading="eager"
							fetchpriority="low"
							decoding="async"
							draggable="false"
						/>
					</div>
				</div>
			</div>
		</section>

		<Projects />
		<Studio />
		<Contact />
	</main>
</Layout>

<style>
	.hero {
		box-sizing: border-box;
		height: 100dvh;
		min-height: 100dvh;
		display: grid;
		padding: 0;
		overflow: hidden;
	}

	.hero-content {
		align-self: center;
		padding: clamp(1.5rem, 5vw, 5rem);
	}

	h1 {
		margin: 0;
		font-family: var(--font-instrument-serif), serif;
		font-weight: 400;
		font-size: clamp(3rem, 9vw, 10rem);
		letter-spacing: -0.02em;
		color: var(--color-secondary);
		line-height: 0.8;
	}

	.rose {
		display: block;
		font-size: 0.5em;
	}

	.meraki {
		display: block;
		font-size: 1.15em;
	}

	.hero-media {
		position: relative;
		min-height: 0;
		overflow: clip;
		isolation: isolate;
	}

	.hero-media__stage {
		position: absolute;
		inset: 0;
		transform: scale(1);
		transform-origin: 50% 50%;
		transition: transform 1s cubic-bezier(0.22, 0.61, 0.36, 1);
		will-change: transform;
	}

	.hero-media__lines {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.hero-media__lines-art {
		position: absolute;
		inset: 0;
		background-color: var(--color-white);
		transition: background-color 0.75s cubic-bezier(0.65, 0.05, 0, 1);
		-webkit-mask-image: var(--line-mask);
		mask-image: var(--line-mask);
		-webkit-mask-repeat: no-repeat;
		mask-repeat: no-repeat;
		-webkit-mask-position: center;
		mask-position: center;
		-webkit-mask-size: contain;
		mask-size: contain;
	}

	.hero-media__color {
		position: absolute;
		inset: 0;
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.6s cubic-bezier(0.22, 0.61, 0.36, 1);
	}

	.hero-image {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		object-position: center;
		user-select: none;
		-webkit-user-drag: none;
	}

	@media (hover: hover) and (pointer: fine) {
		.hero-media:hover .hero-media__stage {
			transform: scale(1.032);
		}

		.hero-media:hover .hero-media__color {
			opacity: 1;
		}

		.hero-media:hover .hero-media__lines-art {
			background-color: var(--color-secondary);
		}
	}

	/* Touch devices get the full-color portrait once it enters the viewport. */
	.hero-media.is-revealed .hero-media__color {
		opacity: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-media__stage {
			transform: none !important;
			transition: none;
		}

		/* Show the finished, full-color portrait with no animation. */
		.hero-media__lines {
			display: none;
		}

		.hero-media__color {
			opacity: 1;
			transition: none;
		}
	}

	@media (min-width: 769px) {
		.hero {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			grid-template-rows: minmax(0, 1fr);
			align-items: stretch;
		}
	}

	@media (max-width: 768px) {
		.hero {
			grid-template-columns: 1fr;
			grid-template-rows: auto minmax(0, 1fr);
		}

		.hero-content {
			align-self: start;
		}

		h1 {
			font-size: clamp(2.5rem, 16vw, 6rem);
		}
	}
</style>

<script>
	const media = document.querySelector('[data-reveal]');

	if (media instanceof HTMLElement) {
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');

		if (!reducedMotion.matches && !finePointer.matches) {
			// Touch devices: paint the full-color portrait once it enters the
			// viewport. Hover devices use the :hover rule in the stylesheet.
			const observer = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (entry.isIntersecting) {
							observer.disconnect();
							media.classList.add('is-revealed');
						}
					}
				},
				{ threshold: 0.4 },
			);

			observer.observe(media);
		}
	}
</script>

<script>
	const sections = document.querySelectorAll('[data-section-reveal]');
	const reducedMotionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');

	if (sections.length > 0) {
		if (reducedMotionPreference.matches) {
			for (const section of sections) {
				section.classList.add('is-visible');
			}
		} else {
			const observer = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (!entry.isIntersecting) continue;

						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					}
				},
				{ threshold: 0, rootMargin: '0px 0px -8% 0px' },
			);

			for (const section of sections) {
				observer.observe(section);
			}
		}
	}
</script>
